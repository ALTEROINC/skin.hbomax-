<?xml version="1.0" encoding="UTF-8"?>
<!-- Full-screen grid for any row's See All tile and for genre tiles. Same look as the Browse window (1115), but scrolling is continuous:
     genre_scroll.py grows HBM.GenreLen (pages merged into the list) as focus nears the end, so there is
     no Next page item and only the pages you actually reach are requested. -->
<window id="1116">
  <defaultcontrol always="true">800</defaultcontrol>
  <onload>RunScript(special://skin/resources/scripts/genre_scroll.py)</onload>
  <animation effect="fade" time="200">WindowOpen</animation>
  <animation effect="fade" time="200">WindowClose</animation>
  <controls>

    <!-- Dark background -->
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <aspectratio>stretch</aspectratio>
      <texture colordiffuse="BackgroundBase">white.png</texture>
    </control>

    <!-- Nav rail strip -->
    <control type="image">
      <left>0</left><top>0</top><width>88</width><height>1080</height>
      <aspectratio>stretch</aspectratio>
      <texture colordiffuse="BackgroundBase">white.png</texture>
    </control>
    <control type="image">
      <left>87</left><top>0</top><width>1</width><height>1080</height>
      <aspectratio>stretch</aspectratio>
      <texture colordiffuse="SurfaceStroke">white.png</texture>
    </control>
    <control type="image">
      <left>16</left><top>18</top><width>64</width><height>64</height>
      <aspectratio align="center" aligny="center">keep</aspectratio>
      <texture>special://skin/media/brand/hbo_white.png</texture>
    </control>

    <!-- Back button on rail — closes this window -->
    <control type="button" id="700">
      <left>0</left><top>0</top><width>88</width><height>1080</height>
      <label />
      <texturenofocus />
      <texturefocus />
      <onclick>Action(back)</onclick>
      <onright>800</onright>
      <onleft>700</onleft>
    </control>

    <!-- Header: genre name -->
    <control type="label">
      <left>160</left><top>14</top><width>1700</width><height>48</height>
      <label>$INFO[Skin.String(HBM.GenreLabel)]</label>
      <font>HBM_Browse_Title</font>
      <textcolor>TextPrimary</textcolor>
    </control>

    <!-- ═══ POSTER GRID ═══ Card 294x441 (2:3), cell 305x465: 6 columns across 1830px.
         The panel scrolls natively; list growth is handled by genre_scroll.py. -->
    <control type="panel" id="800">
      <left>88</left><top>88</top><width>1830</width><height>992</height>
      <orientation>vertical</orientation>
      <scrolltime tween="cubic" easing="out">300</scrolltime>
      <preloaditems>3</preloaditems>
      <!-- Another addon's own Next page item (TMDb lists never have one here: nextpage=False): load that page in place. -->
      <onclick condition="$EXP[HBM_IsSeeAll]">Skin.SetString(HBM.GenreURL,$INFO[ListItem.FolderPath])</onclick>
      <onclick condition="!$EXP[HBM_IsSeeAll]">Action(info)</onclick>
      <onleft>700</onleft>
      <onright>800</onright>
      <content target="videos">$VAR[HBM_GenreSource]</content>



      <itemlayout width="305" height="465">
        <control type="image"><left>0</left><top>0</top><width>294</width><height>441</height><aspectratio>stretch</aspectratio><texture colordiffuse="1A161C24">white.png</texture><visible>!$EXP[HBM_IsSeeAll]</visible></control>
        <control type="image"><left>0</left><top>0</top><width>294</width><height>441</height><aspectratio>scale</aspectratio><texture>$INFO[ListItem.Art(poster)]</texture><visible>!$EXP[HBM_IsSeeAll]</visible></control>
        <control type="image"><left>0</left><top>0</top><width>294</width><height>441</height><aspectratio>scale</aspectratio><texture>$INFO[ListItem.Art(thumb)]</texture><visible>!$EXP[HBM_IsSeeAll]</visible></control>
              <control type="image"><left>0</left><top>0</top><width>294</width><height>441</height><aspectratio>scale</aspectratio><texture>special://skin/media/seeall_poster.png</texture><visible>$EXP[HBM_IsSeeAll]</visible></control>
      </itemlayout>

      <focusedlayout width="305" height="465">
        <control type="image"><left>0</left><top>0</top><width>294</width><height>441</height><aspectratio>stretch</aspectratio><texture colordiffuse="FFFFFFFF">white.png</texture><visible>!$EXP[HBM_IsSeeAll]</visible></control>
        <control type="image"><left>2</left><top>2</top><width>290</width><height>437</height><aspectratio>stretch</aspectratio><texture colordiffuse="1A161C24">white.png</texture><visible>!$EXP[HBM_IsSeeAll]</visible></control>
        <control type="image"><left>2</left><top>2</top><width>290</width><height>437</height><aspectratio>scale</aspectratio><texture>$INFO[ListItem.Art(poster)]</texture><visible>!$EXP[HBM_IsSeeAll]</visible></control>
        <control type="image"><left>2</left><top>2</top><width>290</width><height>437</height><aspectratio>scale</aspectratio><texture>$INFO[ListItem.Art(thumb)]</texture><visible>!$EXP[HBM_IsSeeAll]</visible></control>
              <control type="image"><left>0</left><top>0</top><width>294</width><height>441</height><aspectratio>stretch</aspectratio><texture colordiffuse="FFFFFFFF">white.png</texture><visible>$EXP[HBM_IsSeeAll]</visible></control>
        <control type="image"><left>3</left><top>3</top><width>288</width><height>435</height><aspectratio>scale</aspectratio><texture>special://skin/media/seeall_poster.png</texture><visible>$EXP[HBM_IsSeeAll]</visible></control>
      </focusedlayout>
    </control>

  </controls>
</window>
